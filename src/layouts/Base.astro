---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import { identity } from "../data/profile";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  structuredData?: boolean;
}
const { title, description, path = "/", noindex = false, structuredData = false } = Astro.props;
const home = path === "/";
// On the homepage, section links are plain anchors;
// on subpages they route back to the homepage sections.
const anchor = (id: string) => (home ? `#${id}` : `/#${id}`);
const nav = [
  { href: anchor("expertise"), label: "Expertise" },
  { href: anchor("work"), label: "Work" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/blog", label: "Blog" },
  { href: "/consulting", label: "Consulting" },
  { href: "/resume", label: "Résumé" },
];
// highlight the nav item for the current page (and its subpaths)
const isActive = (href: string) =>
  href.startsWith("/") && !href.startsWith("/#") && (path === href || path.startsWith(href + "/"));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // set theme before first paint to avoid flash
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
    <!-- AI training opt-out (proposed directives + W3C TDM Reservation Protocol) -->
    <meta name="robots" content="noai, noimageai" />
    <meta name="tdm-reservation" content="1" />
    <Seo title={title} description={description} path={path} noindex={noindex} structuredData={structuredData} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Emanuel Antablin — Blog" href="/rss.xml" />

    <!-- GoatCounter analytics (privacy-friendly, cookieless). Records host+path
         so all *.antablin.com sites stay distinguishable in one dashboard. -->
    <script is:inline>
      window.goatcounter = { path: (p) => location.host + (p || location.pathname) };
    </script>
    <script
      is:inline
      data-goatcounter="https://chop5091.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- nav -->
    <header class="nav">
      <a class="nav__brand" href="https://www.antablin.com" aria-label="The Antablin family — antablin.com">
        <span class="nav__name">EMANUEL ANTABLIN</span>
      </a>
      <nav class="nav__links" aria-label="Primary">
        {
          nav.map((n) => (
            <a
              href={n.href}
              class:list={[{ "is-active": isActive(n.href) }]}
              aria-current={isActive(n.href) ? "page" : undefined}
            >
              {n.label}
            </a>
          ))
        }
      </nav>
      <button class="theme-toggle" id="themeToggle" title="Toggle dark mode" aria-label="Toggle dark mode" aria-pressed="false">
        <!-- Star (shown in light mode — Mario Super Star), from the original v1 site -->
        <svg class="theme-toggle__star" viewBox="0 0 48 48" width="28" height="28">
          <defs>
            <radialGradient id="starGrad" cx="50%" cy="45%" r="55%">
              <stop offset="0%" stop-color="#fff46e"/>
              <stop offset="40%" stop-color="#ffd700"/>
              <stop offset="100%" stop-color="#d4a800"/>
            </radialGradient>
          </defs>
          <polygon points="24,1 29,16 45,16 32,26 37,42 24,32 11,42 16,26 3,16 19,16" fill="url(#starGrad)" stroke="#b8860b" stroke-width="0.8"/>
          <ellipse cx="20" cy="22" rx="2.2" ry="3.5" fill="#1a1a1a"/>
          <ellipse cx="28" cy="22" rx="2.2" ry="3.5" fill="#1a1a1a"/>
          <ellipse cx="20.6" cy="20.5" rx="0.9" ry="1.2" fill="rgba(255,255,255,0.6)"/>
          <ellipse cx="28.6" cy="20.5" rx="0.9" ry="1.2" fill="rgba(255,255,255,0.6)"/>
        </svg>
        <!-- Moon (shown in dark mode — Majora's Mask), from the original v1 site -->
        <svg class="theme-toggle__moon" viewBox="0 0 64 64" width="28" height="28">
          <defs>
            <radialGradient id="moonGrad" cx="45%" cy="40%" r="50%">
              <stop offset="0%" stop-color="#a89880"/>
              <stop offset="30%" stop-color="#8a7a68"/>
              <stop offset="60%" stop-color="#6a5a4a"/>
              <stop offset="100%" stop-color="#3a3028"/>
            </radialGradient>
          </defs>
          <circle cx="32" cy="32" r="29" fill="url(#moonGrad)" stroke="#2a2018" stroke-width="0.8"/>
          <circle cx="10" cy="14" r="3" fill="rgba(0,0,0,0.2)"/>
          <circle cx="8" cy="22" r="2" fill="rgba(0,0,0,0.15)"/>
          <circle cx="54" cy="12" r="2.5" fill="rgba(0,0,0,0.18)"/>
          <circle cx="52" cy="48" r="3.5" fill="rgba(0,0,0,0.2)"/>
          <circle cx="12" cy="46" r="2.5" fill="rgba(0,0,0,0.18)"/>
          <circle cx="48" cy="30" r="2" fill="rgba(0,0,0,0.15)"/>
          <circle cx="16" cy="34" r="1.5" fill="rgba(0,0,0,0.13)"/>
          <circle cx="56" cy="38" r="1.8" fill="rgba(0,0,0,0.14)"/>
          <circle cx="10" cy="52" r="2" fill="rgba(0,0,0,0.16)"/>
          <circle cx="50" cy="54" r="1.5" fill="rgba(0,0,0,0.14)"/>
          <circle cx="44" cy="10" r="1.8" fill="rgba(0,0,0,0.12)"/>
          <circle cx="20" cy="8" r="2.2" fill="rgba(0,0,0,0.16)"/>
          <circle cx="36" cy="6" r="1.5" fill="rgba(0,0,0,0.13)"/>
          <circle cx="6" cy="36" r="1.2" fill="rgba(0,0,0,0.12)"/>
          <circle cx="56" cy="24" r="1.5" fill="rgba(0,0,0,0.13)"/>
          <path d="M13 22 Q18 17 27 21" fill="#5a4a3a" stroke="#3a2a1a" stroke-width="0.6"/>
          <path d="M51 22 Q46 17 37 21" fill="#5a4a3a" stroke="#3a2a1a" stroke-width="0.6"/>
          <ellipse cx="22" cy="26" rx="7.5" ry="6.5" fill="#0a0500"/>
          <ellipse cx="42" cy="26" rx="7.5" ry="6.5" fill="#0a0500"/>
          <circle cx="22" cy="27" r="3.5" fill="#cc6600"/>
          <circle cx="42" cy="27" r="3.5" fill="#cc6600"/>
          <circle cx="22" cy="27" r="4" fill="none" stroke="#dd8800" stroke-width="0.5"/>
          <circle cx="42" cy="27" r="4" fill="none" stroke="#dd8800" stroke-width="0.5"/>
          <circle cx="22" cy="27" r="1.5" fill="#1a0800"/>
          <circle cx="42" cy="27" r="1.5" fill="#1a0800"/>
          <circle cx="22" cy="27" r="2.5" fill="none" stroke="#ee4400" stroke-width="0.4"/>
          <circle cx="42" cy="27" r="2.5" fill="none" stroke="#ee4400" stroke-width="0.4"/>
          <path d="M30 24 L28 36 L32 40 L36 36 L34 24 Z" fill="#6a5a4a" stroke="#3a2a1a" stroke-width="0.5"/>
          <path d="M31 25 L30 34 L32 37 L34 34 L33 25" fill="#7a6a58" stroke="none"/>
          <ellipse cx="30" cy="37" rx="1.2" ry="0.8" fill="#1a0a00"/>
          <ellipse cx="34" cy="37" rx="1.2" ry="0.8" fill="#1a0a00"/>
          <path d="M16 44 Q18 40 24 42 Q28 40 32 42 Q36 40 40 42 Q46 40 48 44 Q44 48 32 48 Q20 48 16 44 Z" fill="#1a0a00"/>
          <rect x="18" y="42" width="3.5" height="3" rx="0.8" fill="#c8b898"/>
          <rect x="22" y="41.5" width="3.5" height="3.5" rx="0.8" fill="#d4c4a0"/>
          <rect x="26" y="41.5" width="3.5" height="3" rx="0.8" fill="#c8b898"/>
          <rect x="30" y="41.5" width="3.5" height="3.5" rx="0.8" fill="#d4c4a0"/>
          <rect x="34" y="41.5" width="3.5" height="3" rx="0.8" fill="#c8b898"/>
          <rect x="38" y="41.5" width="3.5" height="3.5" rx="0.8" fill="#d4c4a0"/>
          <rect x="42" y="42" width="3.5" height="3" rx="0.8" fill="#c8b898"/>
          <rect x="20" y="45.5" width="3" height="2" rx="0.6" fill="#b8a888"/>
          <rect x="24" y="46" width="3" height="2" rx="0.6" fill="#c4b498"/>
          <rect x="28" y="46" width="3" height="1.8" rx="0.6" fill="#b8a888"/>
          <rect x="32" y="46" width="3" height="2" rx="0.6" fill="#c4b498"/>
          <rect x="36" y="46" width="3" height="1.8" rx="0.6" fill="#b8a888"/>
          <rect x="40" y="45.5" width="3" height="2" rx="0.6" fill="#c4b498"/>
          <path d="M12 34 Q16 38 18 42" fill="none" stroke="rgba(0,0,0,0.25)" stroke-width="1"/>
          <path d="M52 34 Q48 38 46 42" fill="none" stroke="rgba(0,0,0,0.25)" stroke-width="1"/>
          <path d="M18 48 Q25 54 32 55 Q39 54 46 48" fill="none" stroke="rgba(0,0,0,0.2)" stroke-width="0.8"/>
        </svg>
      </button>
      <a class="nav__cta" href="/contact">Get in touch</a>
    </header>

    <slot />

    <script is:inline>
      // dark-mode toggle — persisted, syncs the theme-color meta
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById("themeToggle");
        const meta = document.querySelector('meta[name="theme-color"]');
        const sync = () => {
          const dark = root.dataset.theme === "dark";
          btn?.setAttribute("aria-pressed", String(dark));
          meta?.setAttribute("content", dark ? "#000000" : "#ffffff");
        };
        sync();
        btn?.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          localStorage.setItem("theme", next);
          root.dataset.theme = next;
          sync();
        });
      })();
    </script>

    <!-- footer -->
    <footer class="footer">
      <div class="wrap footer__wrap">
        <span class="footer__brand">EMANUEL&nbsp;ANTABLIN</span>
        <nav class="footer__nav" aria-label="Footer">
          <a href="/portfolio">Portfolio</a>
          <a href="/blog">Blog</a>
          <a href="/consulting">Consulting</a>
          <a href="/resume">Résumé</a>
          <a href="/contact">Contact</a>
        </nav>
        <span class="footer__meta">© <span id="year">2026</span> · Irvine, CA</span>
        <a class="footer__family" href="https://www.antablin.com">Part of the Antablin family ↗</a>
      </div>
    </footer>
  </body>
</html>
