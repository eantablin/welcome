---
// Standalone 404 — brutally simple.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>404 · Emanuel Antablin</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #fff;
        color: #000;
        font-family: ui-monospace, "Cascadia Mono", "JetBrains Mono", Menlo, Consolas, monospace;
        min-height: 100vh;
        min-height: 100svh;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 24px;
      }
      .tag { text-transform: uppercase; letter-spacing: 3px; font-size: 12px; margin-bottom: 18px; }
      .code { font-size: clamp(4rem, 18vw, 10rem); font-weight: 800; line-height: 0.9; letter-spacing: 2px; }
      .msg { margin: 24px 0 32px; }
      a {
        display: inline-block;
        padding: 14px 28px;
        border: 2px solid #000;
        color: #000;
        background: #fff;
        text-decoration: none;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 1px;
      }
      a:hover { background: #000; color: #fff; }
    </style>
  </head>
  <body>
    <div class="panel">
      <p class="tag">Error · page not found</p>
      <div class="code">404</div>
      <p class="msg">This route does not exist.</p>
      <a href="/">← Back to start</a>
    </div>
  </body>
</html>
