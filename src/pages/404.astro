---
// Standalone "GAME OVER" 404 — lightweight, no boot/WebGL.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#06070d" />
    <title>404 — GAME OVER · Emanuel Antablin</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      :root { --bg:#06070d; --cyan:#2ee6ff; --purple:#a855f7; --magenta:#ff7ac6; --text:#e7ecf5; --muted:#8b94a8; --line:rgba(120,160,220,0.12); }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { background:var(--bg); color:var(--text); font-family:"JetBrains Mono",monospace; min-height:100vh; min-height:100svh; display:grid; place-items:center; text-align:center; padding:24px; overflow:hidden; position:relative; }
      body::before { content:""; position:fixed; inset:-10vmax; background-image:linear-gradient(rgba(120,160,220,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(120,160,220,0.06) 1px,transparent 1px); background-size:46px 46px; mask-image:radial-gradient(ellipse 80% 70% at 50% 50%,#000 45%,transparent 100%); -webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 50%,#000 45%,transparent 100%); }
      body::after { content:""; position:fixed; inset:0; pointer-events:none; background:repeating-linear-gradient(transparent 0 2px,rgba(0,0,0,0.22) 2px 3px); opacity:.5; }
      .panel { position:relative; z-index:1; }
      .tag { font-size:11px; letter-spacing:3px; text-transform:uppercase; color:var(--cyan); margin-bottom:18px; }
      .code { font-family:"Orbitron",monospace; font-weight:900; font-size:clamp(3.5rem,16vw,9rem); line-height:.9; letter-spacing:2px; background:linear-gradient(120deg,var(--magenta),var(--purple)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; filter:drop-shadow(0 0 30px rgba(168,85,247,0.4)); }
      .go { font-family:"Orbitron",monospace; font-weight:700; letter-spacing:4px; font-size:clamp(1rem,3vw,1.6rem); color:var(--magenta); margin:6px 0 28px; animation:blink 1.1s steps(1) infinite; }
      @keyframes blink { 50% { opacity:.35; } }
      .msg { color:var(--muted); margin-bottom:34px; }
      a { display:inline-flex; align-items:center; gap:10px; padding:15px 28px; border:1px solid var(--cyan); color:#04121a; background:var(--cyan); font-weight:600; letter-spacing:1px; border-radius:4px; box-shadow:0 0 26px rgba(46,230,255,0.4); transition:box-shadow .3s; }
      a:hover { box-shadow:0 0 44px rgba(46,230,255,0.7); }
    </style>
  </head>
  <body>
    <div class="panel">
      <p class="tag">Error · level not found</p>
      <div class="code">404</div>
      <div class="go">GAME OVER</div>
      <p class="msg">This route ran out of lives.</p>
      <a href="/">▶ CONTINUE — back to start</a>
    </div>
  </body>
</html>
