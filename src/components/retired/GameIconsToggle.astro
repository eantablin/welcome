<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 2px solid var(--ink, #000);
    background: var(--ink, #000);
    cursor: pointer;
    padding: 0;
  }
  /* icon shows the CURRENT theme: moon in light, shine in dark */
  .theme-toggle__star { display: none; }
  .theme-toggle__moon { display: block; }
  .theme-toggle[aria-pressed="true"] .theme-toggle__star { display: block; }
  .theme-toggle[aria-pressed="true"] .theme-toggle__moon { display: none; }

  /* coin-flip spin on hover — from the v1 site (f6d994d) */
  .flipper {
    display: block;
    position: relative;
    width: 28px;
    height: 28px;
    transform-style: preserve-3d;
  }
  .flipper .icon-front,
  .flipper .icon-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    height: 28px;
    backface-visibility: hidden;
  }
  .flipper .icon-back { transform: rotateY(180deg); }

  .theme-toggle:hover .flipper { animation: iconSpin 1.2s linear infinite; }
  @keyframes iconSpin {
    from { transform: perspective(200px) rotateY(0deg); }
    to { transform: perspective(200px) rotateY(360deg); }
  }

  /* moon grows in chunky sprite-like frames on hover (12 steps);
     closes back in ~35% slower than it opens */
  .theme-toggle__moon {
    transform: scale(0.82);
    transition: transform 0.55s steps(12, end);
  }
  .theme-toggle:hover .theme-toggle__moon {
    transform: scale(1.18);
    transition: transform 0.4s steps(12, end);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle:hover .flipper { animation: none; }
    .theme-toggle__moon { transition: none; }
  }
</style>

